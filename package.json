{
  "name": "widgnot",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "generate:icons": "electron scripts/render-icon.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-ico.ps1",
    "app:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite --port 5173\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
    "build:exe": "npm run build && electron-builder --win",
    "build:portable": "npm run build && electron-builder --win portable",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.widgnot.app",
    "productName": "Widgnot",
    "icon": "build/icon.ico",
    "compression": "normal",
    "asarUnpack": [
      "electron/*.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Widgnot"
    }
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.1.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
